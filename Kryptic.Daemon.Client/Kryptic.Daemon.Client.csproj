<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- netstandard2.0 covers .NET Framework 4.6.2+ and .NET Core 2.0+ (legacy);
             net6.0/net8.0 builds use the in-box System.Text.Json and unix sockets. -->
        <TargetFrameworks>netstandard2.0;net6.0;net8.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>Kryptic.Daemon.Client</PackageId>
        <RootNamespace>Kryptic</RootNamespace>
        <Version>0.1.0</Version>
        <Authors>Kryptic by Theka.dev SINGLE MEMBER P.C.</Authors>
        <Copyright>Copyright (c) 2026 Kryptic by Theka.dev SINGLE MEMBER P.C.</Copyright>
        <Description>Kryptic daemon client for .NET. Passively injects development secrets from the local Kryptic daemon into IConfiguration and environment variables. No-op outside Development.</Description>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://kryptic.dev</PackageProjectUrl>
        <RepositoryUrl>https://github.com/dev-kryptic/Kryptic.Net</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>kryptic;secrets;configuration;daemon</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- Lowest workable dependency per target so legacy apps are never forced to upgrade. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="2.1.1" />
        <PackageReference Include="System.Text.Json" Version="8.0.5" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="6.0.1" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    </ItemGroup>

</Project>
